                  </zone-style>
                </zone>
                <zone fixed-size='280' h='5127' id='47' is-fixed='true' name='Is demand growing and stable?' w='98333' x='750' y='6133'>
                  <layout-cache has-max-size-h='true' maxheight='16' minheight='16' minwidth='166' type-h='scalable' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#818b91' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='3' />
                    <format attr='margin' value='4' />
