                </zone>
                <zone h='765' id='104' mode='dropdown' name='Is demand growing and stable?' param='[federated.1i96p4a0sis4ma1431z5h0jhmmmv].[none:member_casual:nk]' show-exclude='false' show-filter-state='false' type-v2='filter' values='relevant' w='32583' x='66250' y='2181'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
