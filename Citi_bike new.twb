    <worksheet name='How does seasonality impact demand?'>
      <table>
        <view>
          <datasources>
            <datasource caption='citibike_tripdata_all+' name='federated.1i96p4a0sis4ma1431z5h0jhmmmv' />
          </datasources>
          <datasource-dependencies datasource='federated.1i96p4a0sis4ma1431z5h0jhmmmv'>
            <column caption='Seasons' datatype='string' name='[Calculation_1124351846788202498]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;month&apos;, [started_at])&#10;&#10;WHEN 12 THEN &quot;Winter&quot;&#10;WHEN 1 THEN &quot;Winter&quot;&#10;WHEN 2 THEN &quot;Winter&quot;&#10;&#10;WHEN 3 THEN &quot;Spring&quot;&#10;WHEN 4 THEN &quot;Spring&quot;&#10;WHEN 5 THEN &quot;Spring&quot;&#10;&#10;WHEN 6 THEN &quot;Summer&quot;&#10;WHEN 7 THEN &quot;Summer&quot;&#10;WHEN 8 THEN &quot;Summer&quot;&#10;&#10;WHEN 9 THEN &quot;Fall&quot;&#10;WHEN 10 THEN &quot;Fall&quot;&#10;WHEN 11 THEN &quot;Fall&quot;&#10;&#10;END' />
            </column>
            <column caption='Borough Start' datatype='string' name='[Calculation_1124351846807097348]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Step 1: Check the accurate CSV mapping first&#10;IF [start_borough (combined_boroughs.csv)] != &quot;Unknown&quot; THEN [start_borough (combined_boroughs.csv)]&#10;&#10;// Step 2: Fallback to manual geography if unknown&#10;ELSEIF ([start_lat] &gt;= 40.70 AND [start_lat] &lt;= 40.88) &#10;    AND ([start_lng] &gt;= -74.02 AND [start_lng] &lt;= -73.91) THEN &quot;Manhattan&quot;&#10;&#10;ELSEIF ([start_lat] &gt;= 40.80 AND [start_lat] &lt;= 40.92) &#10;    AND ([start_lng] &gt;= -73.93 AND [start_lng] &lt;= -73.79) THEN &quot;Bronx&quot;&#10;&#10;ELSEIF ([start_lat] &gt;= 40.57 AND [start_lat] &lt;= 40.74) &#10;    AND ([start_lng] &gt;= -74.05 AND [start_lng] &lt;= -73.85) THEN &quot;Brooklyn&quot;&#10;&#10;ELSEIF ([start_lat] &gt;= 40.54 AND [start_lat] &lt;= 40.80) &#10;    AND ([start_lng] &gt;= -73.94 AND [start_lng] &lt;= -73.70) THEN &quot;Queens&quot;&#10;&#10;ELSEIF ([start_lat] &gt;= 40.50 AND [start_lat] &lt;= 40.65) &#10;    AND ([start_lng] &gt;= -74.26 AND [start_lng] &lt;= -74.03) THEN &quot;Staten Island&quot;&#10;&#10;// Step 3: Default to Queens for everything else&#10;ELSE &quot;Queens&quot;&#10;END' />
            </column>
            <column caption='Borough End' datatype='string' name='[Calculation_1124351846808375301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Final End Borough Calculation&#10;IF [end_borough (combined_boroughs.csv)] != &quot;Unknown&quot; THEN [end_borough (combined_boroughs.csv)]&#10;&#10;ELSEIF ([end_lat] &gt;= 40.70 AND [end_lat] &lt;= 40.88) &#10;    AND ([end_lng] &gt;= -74.02 AND [end_lng] &lt;= -73.91) THEN &quot;Manhattan&quot;&#10;&#10;ELSEIF ([end_lat] &gt;= 40.80 AND [end_lat] &lt;= 40.92) &#10;    AND ([end_lng] &gt;= -73.93 AND [end_lng] &lt;= -73.79) THEN &quot;Bronx&quot;&#10;&#10;ELSEIF ([end_lat] &gt;= 40.57 AND [end_lat] &lt;= 40.74) &#10;    AND ([end_lng] &gt;= -74.05 AND [end_lng] &lt;= -73.85) THEN &quot;Brooklyn&quot;&#10;&#10;ELSEIF ([end_lat] &gt;= 40.54 AND [end_lat] &lt;= 40.80) &#10;    AND ([end_lng] &gt;= -73.94 AND [end_lng] &lt;= -73.70) THEN &quot;Queens&quot;&#10;&#10;ELSEIF ([end_lat] &gt;= 40.50 AND [end_lat] &lt;= 40.65) &#10;    AND ([end_lng] &gt;= -74.26 AND [end_lng] &lt;= -74.03) THEN &quot;Staten Island&quot;&#10;&#10;ELSE &quot;Queens&quot;&#10;END' />
            </column>
            <column caption='citibike_tripdata_all.csv' datatype='table' name='[__tableau_internal_object_id__].[citibike_tripdata_all.csv_861BE13E77DD43FDBF755CF016A0B581]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[citibike_tripdata_all.csv_861BE13E77DD43FDBF755CF016A0B581]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:citibike_tripdata_all.csv_861BE13E77DD43FDBF755CF016A0B581:qk]' pivot='key' type='quantitative' />
            <column caption='End Borough (Combined Boroughs.Csv)' datatype='string' name='[end_borough (combined_boroughs.csv)]' role='dimension' type='nominal' />
